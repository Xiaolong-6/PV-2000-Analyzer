# Private / local instrument data: never commit
private/**
!private/README.md
*.xps
*.xml
*.csv
*.pdf
*.pptx
*.docx
*.xlsx
*.xls
*.png
*.jpg
*.jpeg
*.zip

# Explicitly published community reference datasets.
# These paths are opt-in exceptions to the broad data-file ignores above.
!reference_data/**/*.xml
!reference_data/**/*.csv
!reference_data/**/*.xps
!reference_data/**/*.png
!reference_data/**/*.jpg
!reference_data/**/*.jpeg

# Explicitly allow repository-owned synthetic fixtures/assets when added later
!tests/fixtures/**/*.xml
!tests/fixtures/**/*.csv
!docs/assets/**/*.png

# Build / local tooling
node_modules/
.DS_Store
Thumbs.db
*.log
coverage/
.tmp/
