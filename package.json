{
  "name": "pv2000-analyzer",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "validate:dit": "node scripts/run_python.js scripts/validate_dit_raw_reference.py",
    "validate:qss": "node scripts/run_python.js scripts/validate_qss_reference.py",
    "validate:dual-qss": "node scripts/run_python.js scripts/validate_dual_qss_reference.py",
    "validate:dual-qss-results": "node scripts/run_python.js scripts/validate_dual_qss_result_reference.py",
    "validate:jzero": "node scripts/run_python.js scripts/validate_jzero_reference.py",
    "validate:isc": "node scripts/run_python.js scripts/validate_isc_reference.py",
    "validate:vcpd": "node scripts/run_python.js scripts/validate_vcpd_reference.py",
    "validate:lbic": "node scripts/run_python.js scripts/validate_lbic_reference.py",
    "validate:cet": "node scripts/run_python.js scripts/validate_cet_reference.py",
    "lint": "eslint src scripts tests",
    "style:check": "node scripts/check-source-density.js",
    "check": "npm run lint && npm run style:check && npm run docs:check && npm test",
    "docs:check": "node scripts/check-docs.js",
    "validate:dual-qss-runtime-results": "node scripts/validate_dual_qss_runtime_reference.js",
    "validate:leakage": "node scripts/run_python.js scripts/validate_leakage_reference.py",
    "validate:spv": "node scripts/run_python.js scripts/validate_spv_reference.py",
    "validate:qss:required": "node scripts/run_python.js --require-data scripts/validate_qss_reference.py",
    "validate:dual-qss:required": "node scripts/run_python.js --require-data scripts/validate_dual_qss_reference.py",
    "validate:dual-qss-results:required": "node scripts/run_python.js --require-data scripts/validate_dual_qss_result_reference.py",
    "validate:lbic:required": "node scripts/run_python.js --require-data scripts/validate_lbic_reference.py"
  },
  "license": "AGPL-3.0-only",
  "author": "Xiaolong Liu",
  "devDependencies": {
    "eslint": "10.11.0",
    "@xmldom/xmldom": "0.9.12"
  }
}
